# .env.example
# Generative AI - Google Gemini
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Música/SFX gerada - Pollinations
VITE_POLLINATIONS_API_KEY=your_pollinations_key_here

# Wiki (local path ou repositório)
VITE_WIKI_PATH=/path/to/wiki
VITE_WIKI_REPO_URL=file:///D:/DOZERO/wikidozero

# Yjs Sync Server
VITE_YJS_WEBSOCKET_URL=ws://localhost:1234

# Sentry Error Tracking (Opcional)
VITE_SENTRY_DSN=your_sentry_dsn_here

# PocketBase Backend
VITE_POCKETBASE_URL=https://your-project.pockethost.io
